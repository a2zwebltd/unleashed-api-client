{
    "name": "a2zwebltd/unleashed-api-client",
    "description": "PHP client for the Unleashed Software inventory management API",
    "type": "library",
    "keywords": [
        "unleashed",
        "unleashed-software",
        "api",
        "api-client",
        "sdk",
        "inventory",
        "inventory-management",
        "php"
    ],
    "homepage": "https://github.com/a2zwebltd/unleashed-api-client",
    "license": "MIT",
    "authors": [
        {
            "name": "Pavel Denisov",
            "email": "pavel@a2zweb.co"
        },
        {
            "name": "A2Z Web",
            "email": "dawid@a2zweb.co"
        }
    ],
    "support": {
        "issues": "https://github.com/a2zwebltd/unleashed-api-client/issues",
        "source": "https://github.com/a2zwebltd/unleashed-api-client",
        "docs": "https://github.com/a2zwebltd/unleashed-api-client#readme"
    },
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Unleashed\\ApiClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Unleashed\\ApiClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
