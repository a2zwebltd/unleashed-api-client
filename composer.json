{
    "name": "a2zwebltd/unleashed-api-client",
    "description": "PHP client for Unleashed Software API",
    "type": "library",
    "keywords": ["unleashed", "api", "client", "inventory", "management"],
    "license": "MIT",
    "authors": [
        {
            "name": "Pavel Denisov",
            "email": "pavel@a2zweb.co"
        },
        {
            "name": "A2Z Web",
            "email": "dawid@a2zweb.co"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^7.0",
        "symfony/serializer": "^7.0",
        "symfony/property-access": "^7.0",
        "symfony/validator": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0",
        "squizlabs/php_codesniffer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Unleashed\\ApiClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Unleashed\\ApiClient\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse",
        "cs-check": "phpcs",
        "cs-fix": "phpcbf"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
